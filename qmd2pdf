#!/usr/bin/env bash
# ============================================================================
# Script:       qmd2pdf
# Version:      1.1.0
# Created:      2026-07-28
# Revised:      2026-07-28
# Purpose:      Render one or more Quarto .qmd documents to PDF from the command
#               line, robustly and project-agnostically; optionally also HTML.
#
#               Sets RENV_CONFIG_AUTOLOADER_ENABLED=FALSE (harmless outside renv;
#               in a renv project it stops the leftover autoloader from blocking
#               on the network). Runs quarto from the document's own directory so
#               quarto finds the enclosing _quarto.yml / execute-dir. The real
#               output path is read back from quarto's "Output created:" line.
#               PDF rendering needs a working LaTeX (e.g. TinyTeX ~/.TinyTeX).
#
#               With --html, each document is ALSO rendered to HTML by delegating
#               to the sibling `qmd2html` (which adds the offline CDN-KaTeX strip
#               when the document's repo provides one), so one call yields both.
#
# Usage:        qmd2pdf [OPTIONS] FILE.qmd [FILE.qmd ...]
# Input:        One or more .qmd files (relative or absolute paths)
# Output:       The PDF quarto produces (and HTML with --html); paths reported
#
# Options:
#   -n, --dry-run    Show the commands without running them
#   -v, --verbose    Pass --verbose to quarto; print each step
#       --html       Also render HTML (via the sibling qmd2html)
#   -h, --help       Show this help message
#
# Requirements:
#   - quarto, a LaTeX engine (TinyTeX); sibling qmd2html for --html
#
# AI Model:     Claude Opus 4.8
# Attribution:  Generated by Michael Gilchrist in collaboration with ClaudeAI Opus 4.8
# ============================================================================
set -o pipefail

if [[ -t 1 ]]; then
    RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' NC=''
fi
ok()   { echo -e "  ${GREEN}ok${NC}   $*"; }
info() { echo -e "  ${BLUE}..${NC}   $*"; }
warn() { echo -e "  ${YELLOW}warn${NC} $*"; }
err()  { echo -e "  ${RED}err${NC}  $*" >&2; }
usage() { sed -n '2,/^# ===.*===$/p' "$0" | sed 's/^# \{0,1\}//; s/^#//'; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Render one .qmd to $2 (html|pdf); echo the created output path. (Same as the
# helper in qmd2html; duplicated so each tool is standalone on PATH.)
qmd_render() {
    local abs="$1" fmt="$2" dry="$3" verbose="$4"
    local dir base vflag log created
    dir="$(cd "$(dirname "$abs")" && pwd)"; base="$(basename "$abs")"
    vflag=""; [[ "$verbose" -eq 1 ]] && vflag="--verbose"
    if [[ "$dry" -eq 1 ]]; then
        echo -e "  ${YELLOW}dry${NC}  (cd '$dir' && RENV_CONFIG_AUTOLOADER_ENABLED=FALSE quarto render '$base' --to $fmt $vflag)" >&2
        return 0
    fi
    [[ "$verbose" -eq 1 ]] && info "cd '$dir' && quarto render '$base' --to $fmt" >&2
    log="$(mktemp)"
    ( cd "$dir" && RENV_CONFIG_AUTOLOADER_ENABLED=FALSE quarto render "$base" --to "$fmt" $vflag ) 2>&1 | tee "$log" >&2
    local st=${PIPESTATUS[0]}
    if [[ $st -ne 0 ]]; then rm -f "$log"; return $st; fi
    created="$(grep -oiP 'Output created:\s*\K.*' "$log" | tail -1)"; rm -f "$log"
    [[ -z "$created" ]] && return 0
    ( cd "$dir" && realpath -m "$created" )
}

DRY=0 VERBOSE=0 ALSO_HTML=0
FILES=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--dry-run) DRY=1 ;;
        -v|--verbose) VERBOSE=1 ;;
        --html)       ALSO_HTML=1 ;;
        -h|--help)    usage; exit 0 ;;
        -*)           err "unknown option: $1"; usage; exit 2 ;;
        *)            FILES+=("$1") ;;
    esac
    shift
done
[[ ${#FILES[@]} -eq 0 ]] && { err "no .qmd file given"; usage; exit 2; }

rc=0
for f in "${FILES[@]}"; do
    abs="$(cd "$(dirname "$f")" 2>/dev/null && pwd)/$(basename "$f")"
    [[ -f "$abs" ]]       || { err "no such file: $f"; rc=1; continue; }
    [[ "$abs" == *.qmd ]] || { err "not a .qmd file: $f"; rc=1; continue; }

    echo -e "${BLUE}==>${NC} $f -> pdf"
    out="$(qmd_render "$abs" pdf "$DRY" "$VERBOSE")" || { rc=1; continue; }
    [[ $DRY -eq 0 && -n "$out" && -f "$out" ]] && ok "wrote $out"

    if [[ $ALSO_HTML -eq 1 ]]; then
        hflags=""; [[ $DRY -eq 1 ]] && hflags+=" -n"; [[ $VERBOSE -eq 1 ]] && hflags+=" -v"
        if [[ -x "$SCRIPT_DIR/qmd2html" ]]; then
            "$SCRIPT_DIR/qmd2html"$hflags "$abs" || rc=1
        else
            warn "sibling qmd2html not found in $SCRIPT_DIR; skipping --html"; rc=1
        fi
    fi
done
exit $rc
