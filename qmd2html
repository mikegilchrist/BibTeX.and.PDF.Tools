#!/usr/bin/env bash
# ============================================================================
# Script:       qmd2html
# Version:      1.1.0
# Created:      2026-07-28
# Revised:      2026-07-28
# Purpose:      Render one or more Quarto .qmd documents to HTML from the command
#               line, robustly and project-agnostically.
#
#               Sets RENV_CONFIG_AUTOLOADER_ENABLED=FALSE (harmless outside renv;
#               in a renv project it stops the leftover autoloader from blocking
#               on the network). Runs quarto from the document's own directory so
#               quarto finds the enclosing _quarto.yml / execute-dir. The real
#               output path is read back from quarto's "Output created:" line, so
#               no assumption is made about output-dir.
#
#               OFFLINE MATH: if the document's git repo contains an executable
#               bin/strip_cdn_katex.sh (as this author's Quarto+KaTeX projects
#               do), it is run on the rendered HTML to remove quarto's CDN KaTeX
#               loader, leaving self-hosted offline math. Auto-detected: repos
#               without that helper are simply left as quarto produced them.
#
# Usage:        qmd2html [OPTIONS] FILE.qmd [FILE.qmd ...]
# Input:        One or more .qmd files (relative or absolute paths)
# Output:       The HTML quarto produces (path reported per file)
#
# Options:
#   -n, --dry-run    Show the commands without running them
#   -v, --verbose    Pass --verbose to quarto; print each step
#       --no-strip   Do not run a detected strip_cdn_katex.sh
#   -h, --help       Show this help message
#
# Requirements:
#   - quarto (git only needed for the offline-strip auto-detection)
#
# AI Model:     Claude Opus 4.8
# Attribution:  Generated by Michael Gilchrist in collaboration with ClaudeAI Opus 4.8
# ============================================================================
set -o pipefail

if [[ -t 1 ]]; then
    RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' NC=''
fi
ok()   { echo -e "  ${GREEN}ok${NC}   $*"; }
info() { echo -e "  ${BLUE}..${NC}   $*"; }
warn() { echo -e "  ${YELLOW}warn${NC} $*"; }
err()  { echo -e "  ${RED}err${NC}  $*" >&2; }
usage() { sed -n '2,/^# ===.*===$/p' "$0" | sed 's/^# \{0,1\}//; s/^#//'; }

DRY=0 VERBOSE=0 STRIP=1
FILES=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--dry-run) DRY=1 ;;
        -v|--verbose) VERBOSE=1 ;;
        --no-strip)   STRIP=0 ;;
        -h|--help)    usage; exit 0 ;;
        -*)           err "unknown option: $1"; usage; exit 2 ;;
        *)            FILES+=("$1") ;;
    esac
    shift
done
[[ ${#FILES[@]} -eq 0 ]] && { err "no .qmd file given"; usage; exit 2; }

# Render one .qmd to the given format ($2 = html|pdf). Echoes the created output
# path on stdout (empty on failure/dry-run). Shared by qmd2html and qmd2pdf.
qmd_render() {
    local abs="$1" fmt="$2" dry="$3" verbose="$4"
    local dir base vflag log created out
    dir="$(cd "$(dirname "$abs")" && pwd)"; base="$(basename "$abs")"
    vflag=""; [[ "$verbose" -eq 1 ]] && vflag="--verbose"

    if [[ "$dry" -eq 1 ]]; then
        echo -e "  ${YELLOW}dry${NC}  (cd '$dir' && RENV_CONFIG_AUTOLOADER_ENABLED=FALSE quarto render '$base' --to $fmt $vflag)" >&2
        return 0
    fi
    [[ "$verbose" -eq 1 ]] && info "cd '$dir' && quarto render '$base' --to $fmt" >&2
    log="$(mktemp)"
    ( cd "$dir" && RENV_CONFIG_AUTOLOADER_ENABLED=FALSE quarto render "$base" --to "$fmt" $vflag ) 2>&1 | tee "$log" >&2
    local st=${PIPESTATUS[0]}
    if [[ $st -ne 0 ]]; then rm -f "$log"; return $st; fi
    created="$(grep -oiP 'Output created:\s*\K.*' "$log" | tail -1)"; rm -f "$log"
    [[ -z "$created" ]] && return 0
    ( cd "$dir" && realpath -m "$created" )   # resolve relative to the doc dir
}

rc=0
for f in "${FILES[@]}"; do
    abs="$(cd "$(dirname "$f")" 2>/dev/null && pwd)/$(basename "$f")"
    [[ -f "$abs" ]]     || { err "no such file: $f"; rc=1; continue; }
    [[ "$abs" == *.qmd ]] || { err "not a .qmd file: $f"; rc=1; continue; }

    echo -e "${BLUE}==>${NC} $f -> html"
    out="$(qmd_render "$abs" html "$DRY" "$VERBOSE")" || { rc=1; continue; }
    [[ $DRY -eq 1 ]] && continue
    [[ -n "$out" && -f "$out" ]] && ok "wrote $out"

    if [[ $STRIP -eq 1 && -n "$out" ]]; then
        repo="$(cd "$(dirname "$abs")" && git rev-parse --show-toplevel 2>/dev/null)"
        strip="$repo/bin/strip_cdn_katex.sh"
        if [[ -n "$repo" && -x "$strip" ]]; then
            [[ $VERBOSE -eq 1 ]] && info "offline: $strip"
            "$strip" "$out" >&2 || rc=1
        fi
    fi
done
exit $rc
